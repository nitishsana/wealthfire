# Vite mode `localkyc` (CMD files/Wealthfire Preview.cmd runs `vite --mode localkyc`).
# Points the app at the local KYC server on this computer (services/kyc/local, STAGE=local, no AWS).
# Committed on purpose: loopback addresses only, no secrets. See .kiro/specs/final-kyc-service/local-mode.md.
VITE_API_URL=http://127.0.0.1:5181
VITE_KYC_REDIRECT_ORIGINS=http://127.0.0.1:5181
