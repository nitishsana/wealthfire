{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@wealthfire/core": ["../../packages/core/src"],
      "@wealthfire/mobile-ui": ["../../packages/mobile-ui/src"],
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["App.tsx", "../../packages/core/src", "../../packages/mobile-ui/src"]
}
