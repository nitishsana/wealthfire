{
  "expo": {
    "name": "Wealthfire",
    "slug": "wealthfire-ios",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1115",
    "platforms": ["ios"],
    "experiments": { "tsconfigPaths": false },
    "scheme": "com.nitishsana.wealthfire",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Wealthfire uses the camera for your KYC selfie and ID card photos.",
          "photosPermission": "Wealthfire lets you pick your ID card photos from your gallery.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "googleIosClientId": ""
    },
    "ios": {
      "bundleIdentifier": "com.nitishsana.wealthfire",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false }
    }
  }
}
